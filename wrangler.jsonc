{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anbsn-sovereign-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "observability": {
    "enabled": true
  },
  "vars": {
    "NETWORK": "ethereum-mainnet",
    "CHAIN_ID": "1",
    "ALIGNMENT_FREQUENCY": "1.25T_NAIRA_INVERSION"
  },
  "workflows": [
    {
      "name": "sovereign-sync-workflow",
      "binding": "SOVEREIGN_WORKFLOW",
      "class_name": "SovereignSyncWorkflow"
    }
  ]
}
